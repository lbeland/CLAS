# Ignore all
*

# Unignore all with extensions
!*.*

# Unignore all dirs
!*/

venv/*
*/venv_iaf/*
**/build/*
.vscode/
__pycache__/
*.egg-info/

*.csv
*.bin
*.h5

fftw-3.3.10

*.png
_last_run
_last_run_group

*.filter
*.svg
*.pgf
*/filters/

# Always commit license files (they have no extension, so "*" above ignores them)
!LICENSE*

results/

CMakeFiles

# cecHT_ext overlay: results/ is already ignored above (regenerable, ~12 GB);
# keep the committed figures despite the repo-wide *.png / *.csv ignores.
!IAF_Estimation/cecHT_ext/figures/*.png

!stim_protocol.csv

# FetchContent download cache (Falcon upstream)
.cache/

analysis_output/
